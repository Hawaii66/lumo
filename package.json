{
  "name": "lumo",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "./convex/lib/performancePolyfill.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite dev'",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npx convex deploy --cmd 'npm run build' && npm run posthog:apply && wrangler deploy",
    "deploy:web": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "format": "prettier --write .",
    "lint": "npm run typecheck && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "posthog:apply": "node ./scripts/posthog-definitions.mjs apply && node ./scripts/posthog-fix-dashboard-tiles.mjs",
    "posthog:dry": "node ./scripts/posthog-definitions.mjs apply --dry-run",
    "posthog:fix-tiles": "node ./scripts/posthog-fix-dashboard-tiles.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@base-ui/react": "^1.8.0",
    "@convex-dev/agent": "^0.7.7",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/stripe": "^0.1.7",
    "@embedpdf/core": "^2.15.1",
    "@embedpdf/engines": "^2.15.1",
    "@embedpdf/models": "^2.15.1",
    "@embedpdf/plugin-document-manager": "^2.15.1",
    "@embedpdf/plugin-render": "^2.15.1",
    "@embedpdf/plugin-scroll": "^2.15.1",
    "@embedpdf/plugin-viewport": "^2.15.1",
    "@embedpdf/react-pdf-viewer": "^2.15.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.1",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@posthog/ai": "^8.19.2",
    "@posthog/convex": "^2.1.9",
    "@posthog/react": "^1.11.3",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.36",
    "ai": "^7.0.134",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "^1.44.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.53.0",
    "mathlive": "^0.111.0",
    "motion": "^14.9.1",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.447.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "stripe": "^23.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@posthog/definitions": "^0.1.0-alpha.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
